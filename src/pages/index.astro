---
import Layout from '~/layouts/Layout.astro'
import { getLanyard } from '~/lib/api'
import Bookmarks from '~/components/Bookmarks'
import { readFileSync } from 'fs'
import { join } from 'path'

const lanyard = await getLanyard().catch(() => null)
const discordStatus = lanyard?.discord_status ?? 'offline'

const read = (f: string, fallback: any) => {
  try { return JSON.parse(readFileSync(join(process.cwd(), 'public/data', f), 'utf-8')) } catch { return fallback }
}

const ghUser      = read('github-user.json', { public_repos: 0, followers: 0 })
const traktStats  = read('trakt-stats.json', { movies: { watched: 0 }, shows: { watched: 0 } })
const lfmUser     = read('lastfm-user.json', { playcount: '0' })
const wakaStats   = read('wakatime-stats-7d.json', { human_readable: '0 hrs', languages: [] })
const lbNow       = read('lb-playing-now.json', null)
const recentMovies= read('trakt-movies-enriched.json', [])

const topLang    = wakaStats.languages?.[0]?.name ?? null
const lastMovie  = recentMovies?.[0] ?? null
const hasLiveData = Boolean(lbNow?.track || (lastMovie?._tmdb?.poster_path) || topLang)
const scrobbles  = Number(lfmUser.playcount || 0).toLocaleString()
---

<Layout title="Home" description="Chirag Singhal — Software Engineer · Backend · AI Systems · Open Source">

  <!-- HERO: the bench powers on. A trace draws across the phosphor screen. -->
  <section class="hero animate-in">
    <div class="signal-strip hero-strip">
      <svg class="waveform" viewBox="0 0 800 120" preserveAspectRatio="none" aria-hidden="true">
        <path class="trace" fill="none" stroke="currentColor" stroke-width="2"
          d="M0,60 L120,60 L150,60 L165,20 L180,100 L195,40 L210,60 L340,60 L360,60 L375,35 L390,85 L405,60 L560,60 L580,60 L595,10 L610,110 L625,60 L800,60" />
      </svg>
    </div>

    <div class="hero-copy">
      <p class="hero-eyeball"><span class="glow-dot" aria-hidden="true"></span> {discordStatus === 'online' ? 'signal live' : 'trace armed'} · backend systems engineer</p>
      <h1 class="text-hero">I build the systems<br />you never see fail.</h1>
      <p class="hero-lede">
        Chirag Singhal. I ship backend and AI infrastructure — Python services, event pipelines, RAG systems —
        and instrument everything I make. This site is the readout: work, open source, and the feeds of a day.
      </p>
      <div class="hero-ctas">
        <a href="/work/projects" class="btn-primary">Trace the work →</a>
        <a href="/resume.pdf" class="btn-ghost">Résumé</a>
      </div>
      <div class="hero-links">
        <a href="https://github.com/chirag127" target="_blank" rel="noopener" class="hero-link">github</a>
        <a href="https://linkedin.com/in/chirag127" target="_blank" rel="noopener" class="hero-link">linkedin</a>
        <a href="mailto:hi@chirag127.in" class="hero-link">hi@chirag127.in</a>
      </div>
    </div>
  </section>

  <!-- READOUT BANK: instrument gauges, not a stat strip -->
  <section class="section-block animate-in">
    <div class="kicker">Channel readout</div>
    <div class="readout-bank">
      <a href="/me/wakatime" class="readout">
        <span class="rv">{wakaStats.human_readable}</span>
        <span class="rl">coding · 7d</span>
        {topLang && <span class="ru">{topLang}</span>}
      </a>
      <a href="/work/open-source" class="readout">
        <span class="rv">{ghUser.public_repos}+</span>
        <span class="rl">github repos</span>
      </a>
      <a href="/library/music/stats" class="readout">
        <span class="rv">{scrobbles}</span>
        <span class="rl">scrobbles</span>
      </a>
      <a href="/library/movies/watched" class="readout">
        <span class="rv">{traktStats.movies?.watched ?? 0}</span>
        <span class="rl">films logged</span>
      </a>
      <div class="readout">
        <span class="rv">Top 1%</span>
        <span class="rl">JEE Advanced</span>
      </div>
    </div>
  </section>

  <!-- INPUT SIGNALS: live feeds -->
  {hasLiveData && (
    <section class="section-block animate-in">
      <div class="kicker">Input signals · live</div>
      <div class="signal-row">
        {lbNow?.track && (
          <div class="card signal-card">
            <span class="live-badge">now playing</span>
            <span class="signal-val">{lbNow.track} — {lbNow.artist}</span>
          </div>
        )}
        {topLang && (
          <div class="card signal-card">
            <span class="live-badge">this week</span>
            <span class="signal-val">Coding {topLang} · {wakaStats.human_readable}</span>
          </div>
        )}
        {lastMovie?._tmdb?.poster_path && (
          <a href="/library/movies/watched" class="poster-card poster-card--sm">
            <img src={`https://image.tmdb.org/t/p/w185${lastMovie._tmdb.poster_path}`} alt={lastMovie.movie?.title ?? 'Last watched'} loading="lazy" />
            <div class="overlay"><div class="overlay-title">{lastMovie.movie?.title}</div></div>
          </a>
        )}
      </div>
    </section>
  )}

  <!-- WHAT I MEASURE (what I do, in the bench idiom) -->
  <section class="section-block animate-in">
    <div class="kicker">Instruments</div>
    <div class="grid-3 disc-grid">
      <div class="card-glow disc">
        <span class="disc-idx">01</span>
        <h3 class="disc-title">Backend systems</h3>
        <p class="disc-desc">Python, FastAPI, Kafka. Latency budgets, event pipelines, distributed correctness.</p>
        <div class="tag-list"><span class="tech-chip">Python</span><span class="tech-chip">FastAPI</span><span class="tech-chip">Kafka</span><span class="tech-chip">Postgres</span></div>
      </div>
      <div class="card-glow disc">
        <span class="disc-idx">02</span>
        <h3 class="disc-title">AI infrastructure</h3>
        <p class="disc-desc">RAG pipelines, multi-agent orchestration, model serving. LangGraph to ONNX.</p>
        <div class="tag-list"><span class="tech-chip">LangGraph</span><span class="tech-chip">RAG</span><span class="tech-chip">ONNX</span></div>
      </div>
      <div class="card-glow disc">
        <span class="disc-idx">03</span>
        <h3 class="disc-title">Open source</h3>
        <p class="disc-desc">192+ tools shipped on oriz.in. Small, free, measured in public.</p>
        <div class="tag-list"><span class="tech-chip">Astro</span><span class="tech-chip">Workers</span><span class="tech-chip">TS</span></div>
      </div>
    </div>
  </section>

  <!-- SHIPPING LOG: featured builds -->
  <section class="section-block animate-in">
    <div class="kicker">Shipping log</div>
    <div class="projects-grid">
      <div class="card project-card">
        <div class="project-impact">192+</div>
        <h3 class="project-name">Oriz</h3>
        <p class="project-desc">Free-forever family of small tools, apps, and content sites. Static + edge compute.</p>
        <div class="tag-list"><span class="tech-chip">Astro</span><span class="tech-chip">Cloudflare</span></div>
        <a href="https://oriz.in" target="_blank" rel="noopener" class="project-link">oriz.in ↗</a>
      </div>
      <div class="card project-card">
        <div class="project-impact">Multi-agent</div>
        <h3 class="project-name">NexusAI</h3>
        <p class="project-desc">Multi-agent RAG with orchestrated LLM pipelines across 10 providers, Kubernetes scale.</p>
        <div class="tag-list"><span class="tech-chip">LangGraph</span><span class="tech-chip">K8s</span></div>
      </div>
      <div class="card project-card">
        <div class="project-impact">T5 · ONNX</div>
        <h3 class="project-name">TubeDigest</h3>
        <p class="project-desc">YouTube summariser. Fine-tuned T5, ONNX runtime for fast inference at the edge.</p>
        <div class="tag-list"><span class="tech-chip">T5</span><span class="tech-chip">Python</span></div>
      </div>
    </div>
  </section>

  <!-- TIMEBASE: highlights as a swept trace -->
  <section class="section-block animate-in">
    <div class="kicker">Timebase</div>
    <div class="timeline" style="padding-left:4px;">
      <div class="timeline-line"></div>
      <div class="timeline-item"><span class="tl-date">Jun 2025</span><span class="tl-text">Software Engineer at TCS — pricing engines, 60% latency cut</span></div>
      <div class="timeline-item"><span class="tl-date">2025</span><span class="tl-text">AWS Certified Developer — Associate</span></div>
      <div class="timeline-item"><span class="tl-date">2024</span><span class="tl-text">192+ open-source tools shipped on oriz.in</span></div>
      <div class="timeline-item timeline-item--dim"><span class="tl-date">2023</span><span class="tl-text">Full-stack at QRsay — 40% API response improvement</span></div>
    </div>
  </section>

  <!-- PERSONAL CHANNEL: Clerk-gated, public-first note -->
  <section class="section-block animate-in">
    <div class="kicker">Your channel · optional</div>
    <div class="card pin-card">
      <p class="pin-note">Everything above is public. Sign in with your oriz.in account to pin pages — they sync across every <span class="num-highlight">*.oriz.in</span> site. Nothing here is gated.</p>
      <Bookmarks client:only="react" />
    </div>
  </section>

</Layout>

<style>
  .hero { padding-top: 1rem; }
  .hero-strip { padding: 34px 0 0; margin-bottom: 1.75rem; }
  .hero-strip .waveform { height: 120px; }
  .hero-copy { max-width: 640px; }
  .hero-eyeball {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-3); display: inline-flex; align-items: center; gap: 8px; margin-bottom: 1.1rem;
  }
  .text-hero { margin-bottom: 1.1rem; }
  .hero-lede { font-size: 16px; color: var(--ink-2); max-width: 560px; line-height: 1.7; margin-bottom: 1.5rem; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 1.25rem; }
  .hero-links { display: flex; flex-wrap: wrap; gap: 18px; }
  .hero-link { font-family: var(--font-mono); font-size: 12px; color: var(--ink-3); letter-spacing: 0.04em; transition: color var(--ease); }
  .hero-link:hover { color: var(--phosphor); }

  .section-block { margin-top: 3rem; }

  .readout-bank { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
  .readout { text-decoration: none; transition: border-color var(--ease), transform var(--ease); }
  a.readout:hover { border-color: color-mix(in srgb, var(--phosphor) 40%, transparent); transform: translateY(-1px); }
  @media (max-width: 900px) { .readout-bank { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .readout-bank { grid-template-columns: 1fr; } }

  .signal-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: stretch; }
  .signal-card { display: flex; flex-direction: column; gap: 7px; flex: 1; min-width: 220px; padding: 14px 16px; }
  .signal-val { font-size: 13px; color: var(--ink); line-height: 1.4; }
  .poster-card--sm { width: 74px; flex-shrink: 0; }

  .disc-grid { align-items: stretch; }
  .disc { display: flex; flex-direction: column; gap: 0.5rem; }
  .disc-idx { font-family: var(--font-mono); font-size: 11px; color: var(--phosphor); letter-spacing: 0.14em; }
  .disc-title { font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; color: var(--ink); }
  .disc-desc { font-size: 13px; color: var(--ink-2); line-height: 1.55; flex: 1; }
  .disc .tag-list { margin-top: 0.4rem; }

  .projects-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
  .project-card { display: flex; flex-direction: column; gap: 0.4rem; }
  .project-impact { font-family: var(--font-mono); font-size: 1.3rem; font-weight: 600; color: var(--phosphor); line-height: 1; margin-bottom: 0.2rem; }
  .project-name { font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; color: var(--ink); }
  .project-desc { font-size: 13px; color: var(--ink-2); line-height: 1.5; flex: 1; }
  .project-link { font-family: var(--font-mono); font-size: 11.5px; color: var(--phosphor); margin-top: 0.35rem; }
  .project-link:hover { color: #8ff0dd; }

  .tl-date { font-family: var(--font-mono); font-size: 11px; color: var(--phosphor); min-width: 76px; display: inline-block; letter-spacing: 0.04em; }
  .tl-text { font-size: 13px; color: var(--ink-2); }
  .timeline-item--dim .tl-date { color: var(--ink-3); }

  .pin-card { max-width: 620px; }
  .pin-note { font-size: 13.5px; color: var(--ink-2); line-height: 1.6; margin-bottom: 1rem; }
</style>
